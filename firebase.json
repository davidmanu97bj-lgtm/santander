{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "tools/**",
      "*.md",
      "*.zip",
      "*.json.map",
      "*.txt",
      "*.sh",
      "CLOUD_SHELL_DESPLEGAR.md",
      "CONFIGURAR_FIREBASE.md",
      "MIGRACION_SANTANDER_A_BARBERIA.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
